# Copy this file to .env. None of these are required to run the app.

# Shared Postgres (Neon or any Postgres URL).
# Leave it empty to use the built-in PGLite database instead.
DATABASE_URL=

# The app door is the email list inside InsightCanvas, not a password login.
# Keep this false unless you are turning on the platform sign-in gate.
VITE_AUTH_ENABLED=false

# Sign-in with emailed one-time codes.
# Required in production: at least 32 random characters (openssl rand -hex 32).
INSIGHT_AUTH_SECRET=
# Optional but recommended: the only address that may become the first admin.
INSIGHT_BOOTSTRAP_EMAIL=
# Mail for sign-in codes: Resend, or SMTP. In local development with neither set,
# the code is printed to the server console.
RESEND_API_KEY=
SMTP_URL=
INSIGHT_MAIL_FROM=
