# Copy this file to .env. None of these are required to run the app.

# Shared Postgres (Neon or any Postgres URL).
# Leave it empty to use the built-in PGLite database instead.
DATABASE_URL=

# The app door is the email list inside InsightCanvas, not a password login.
# Keep this false unless you are turning on the platform sign-in gate.
VITE_AUTH_ENABLED=false
